# Environment variables
# M-001: satu aturan untuk semua file env (.env, .env.local, .env.production, ...). Dulu aturannya tersebar di tiga
# tempat (.env, .env.*, .env*) sehingga mudah tertinggal saat diubah. Hanya contoh isinya (.env.example) yang ikut.
.env*
!.env.example

# Wrangler / Cloudflare / Vercel
.wrangler/
.dev.vars
.vercel

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local generated data, models, and satellite artifacts
# R-004: folder riset diawali "/" supaya hanya berlaku di root proyek (folder ini), tidak ikut membuang folder
# bernama sama di tempat lain. Isi public/ yang dipakai website dimasukkan di bagian "public data bundle" di bawah.
/.local-dev/
/Dataset_Test_Enriched/
/Inference/
